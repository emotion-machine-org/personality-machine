# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=placeholder-value
CLERK_SECRET_KEY=placeholder-value
# Name of the Clerk JWT template used for backend API auth
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=placeholder-value

# FastAPI Server URL
NEXT_PUBLIC_API_URL=http://localhost:8100

# Optional analytics (PostHog is disabled unless a key is set)
# NEXT_PUBLIC_POSTHOG_KEY=placeholder-value
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Development flags
NEXT_PUBLIC_DISABLE_AUTH=false
NEXT_PUBLIC_TEXT_STREAM_ENABLED=true
