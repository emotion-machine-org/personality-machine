# Load Test Configuration
# Copy this file to .env and fill in your values

# API authentication key (required)
EM_API_KEY=emk_live_your_key_here

# Test companion UUID (required)
EM_TEST_COMPANION_ID=your-companion-uuid-here

# Base URL for the API (optional, defaults to production)
EM_BASE_URL=https://api.emotionmachine.ai/api/

# Prefix for generated test user IDs (optional)
EM_TEST_USER_PREFIX=loadtest_user_

# Rate limit awareness (optional)
EM_RATE_LIMIT=100
