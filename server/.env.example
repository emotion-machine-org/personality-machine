ENV=dev

# What the app reads. The migration scripts (app/scripts/migrate*.sh) read
# DATABASE_TRANSACTION_DSN and fall back to DATABASE_DSN.
DATABASE_DSN=postgresql://em:em@localhost:5432/emotion_machine

OPENAI_API_KEY=placeholder-value
GEMINI_API_KEY=placeholder-value

ELEVEN_API_KEY=placeholder-value
CARTESIA_API_KEY=placeholder-value
DEEPGRAM_API_KEY=placeholder-value
OPENROUTER_API_KEY=placeholder-value

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

CLERK_AUTHORIZED_PARTIES="http://localhost:8100, http://localhost:3000, http://localhost:8081, http://localhost:19006"
CLERK_SECRET_KEY=placeholder-value
CLERK_JWKS_URL=placeholder-value
CLERK_JWT_KEY=placeholder-value

# WARNING: never enable in production — disables all auth and exposes GET /api/auth/dev-token
DISABLE_AUTH_FOR_TESTING=false
SEED_ENDPOINT_ENABLED=false

MODAL_ENVIRONMENT=placeholder-value
MODAL_TOKEN_ID=placeholder-value
MODAL_TOKEN_SECRET=placeholder-value

TEXT_CONTEXT_SUMMARY_ENABLED=true
TEXT_LLM_MAX_TOKENS=300

# MEMORY STUFF
MEMORY_RETRIEVAL_ENABLED=true
MEMORY_TOP_K_DEFAULT=12
MEMORY_CANDIDATE_MULTIPLIER=10
MEMORY_HNSW_EF_SEARCH=80
MEMORY_UPDATE_RECENCY_ENABLED=true
MEMORY_RETRIEVAL_TIMEOUT_MS=2500

CORS_ALLOW_ORIGINS="http://localhost:3000, http://localhost:3001, http://localhost:8100, http://localhost:8081, http://localhost:19006"

# AWS STUFF
AWS_ACCESS_KEY_ID=placeholder-value
AWS_SECRET_ACCESS_KEY=placeholder-value
AWS_SESSION_TOKEN=placeholder-value
KNOWLEDGE_S3_BUCKET=placeholder-value
KNOWLEDGE_S3_REGION=placeholder-value
KNOWLEDGE_S3_PREFIX=placeholder-value
CHAT_IMAGES_S3_PREFIX=placeholder-value

EM_API_BASE_URL=http://localhost:8100
TEST_EM_API_KEY=placeholder-value
TEST_EM_COMPANION_ID=placeholder-value
ENCRYPTION_KEY=placeholder-value
INTERNAL_API_KEY=placeholder-value
